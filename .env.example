# ============================================================
#  EXEMPLO DE CONFIGURAÇÃO — copie para .env e preencha
# ============================================================

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gerador_atividades
DB_USER=postgres
DB_PASSWORD=SUA_SENHA_AQUI

FLASK_SECRET_KEY=GERE_UMA_CHAVE_AQUI

# Segurança em Rede Local (Legado — não utilizado com OTP ativo):
CHAVE_RECUPERACAO_SENHA=

# ============================================================
#  CONFIGURAÇÃO DE E-MAIL (SMTP) — Recuperação de senha OTP
# ============================================================
# Sem estas variáveis, o sistema entra em MODO DESENVOLVIMENTO:
# o código OTP é exibido no console/log do servidor em vez de ser enviado.

# Servidor SMTP (exemplos: smtp.gmail.com / smtp.office365.com / seu-servidor-local)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Credenciais de envio
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=sua_senha_de_app_aqui

# Protocolo: TLS (padrão porta 587) ou SSL (porta 465)
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Nome e e-mail exibidos como remetente
SMTP_FROM_NAME=SGPP - Gestão Pedagógica
SMTP_FROM_EMAIL=seuemail@gmail.com

# Provedor: auto | ollama | gemini | openai
IA_PROVIDER=auto

# Ollama local (offline)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# Google Gemini API (gratuita e ultra rápida)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=30

# OpenAI / Groq / LM Studio (opcional)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SERVER_THREADS=4
